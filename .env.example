# Copy this file to `.env` and fill in the values.
#
# `.env` is git-ignored and must never be committed. This file records the
# variable NAMES only — it must never contain a real value.

# FRED / St. Louis Fed — https://fredaccount.stlouisfed.org/apikeys
# Used by the data collector (Phase 2). 32 lowercase alphanumeric characters.
FRED_API_KEY=

# Google Gemini API — https://aistudio.google.com/apikey
# Used by the synthesis step (Phase 3). Sent in the x-goog-api-key header,
# never in a URL query string.
GEMINI_API_KEY=

# Model identifier for synthesis, so a model change needs no code change.
# The value below is documentation of the intended model, not a secret.
# Moving aliases (…-latest, …-preview, …-exp) are refused by the client:
# a brief records the model that produced it, and an alias would silently
# change that between runs.
LLM_MODEL=gemini-3.8-flash
