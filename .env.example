# Copy this file to `.env` and fill in the values.
#
# `.env` is git-ignored and must never be committed. This file records the
# variable NAMES only — it must never contain a real value.

# FRED / St. Louis Fed — https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Language model provider used for the synthesis step
LLM_API_KEY=
