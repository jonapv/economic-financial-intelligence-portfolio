              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ !!$json.error || !$json.candidates?.[0]?.content?.parts?.[0]?.text }}",
              "rightValue": ""
            },
            {
              "operator": {
                "type": "number",
                "operation": "lt"
              },
              "leftValue": "={{ $runIndex }}",
              "rightValue": 9
            }
          ],
