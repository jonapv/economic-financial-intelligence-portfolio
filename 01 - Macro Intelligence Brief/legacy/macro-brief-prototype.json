    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key={{ $env.LLM_API_KEY }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"contents\": [{\"parts\": [{\"text\": \"You are a macroeconomic analyst. I am providing you with the latest and previous data for US CPI, Unemployment, Fed Funds, GDP, and Retail Sales. Write a short, professional sentence for each indicator summarizing the change. Do not invent data. Do not add financial advice. Output ONLY a valid JSON object with these exact keys: \\\"cpi_analysis\\\", \\\"unemployment_analysis\\\", \\\"fedfunds_analysis\\\", \\\"gdp_analysis\\\", \\\"retail_analysis\\\".\\n\\nData:\\n- US CPI (CPIAUCSL): current {{ $('Merge Indicators').first().json.cpi_date_current }} = {{ $('Merge Indicators').first().json.cpi_value_current }}; previous {{ $('Merge Indicators').first().json.cpi_date_previous }} = {{ $('Merge Indicators').first().json.cpi_value_previous }}; direction: {{ $('Merge Indicators').first().json.cpi_direction }}.\\n- US Unemployment Rate (UNRATE): current {{ $('Merge Indicators').first().json.unemployment_date_current }} = {{ $('Merge Indicators').first().json.unemployment_value_current }}; previous {{ $('Merge Indicators').first().json.unemployment_date_previous }} = {{ $('Merge Indicators').first().json.unemployment_value_previous }}; direction: {{ $('Merge Indicators').first().json.unemployment_direction }}.\\n- US Federal Funds Effective Rate (FEDFUNDS): current {{ $('Merge Indicators').first().json.fedfunds_date_current }} = {{ $('Merge Indicators').first().json.fedfunds_value_current }}; previous {{ $('Merge Indicators').first().json.fedfunds_date_previous }} = {{ $('Merge Indicators').first().json.fedfunds_value_previous }}; direction: {{ $('Merge Indicators').first().json.fedfunds_direction }}.\\n- US Real Gross Domestic Product (GDPC1): current {{ $('Merge Indicators').first().json.gdp_date_current }} = {{ $('Merge Indicators').first().json.gdp_value_current }}; previous {{ $('Merge Indicators').first().json.gdp_date_previous }} = {{ $('Merge Indicators').first().json.gdp_value_previous }}; direction: {{ $('Merge Indicators').first().json.gdp_direction }}.\\n- US Advance Retail Sales (RSAFS): current {{ $('Merge Indicators').first().json.retail_date_current }} = {{ $('Merge Indicators').first().json.retail_value_current }}; previous {{ $('Merge Indicators').first().json.retail_date_previous }} = {{ $('Merge Indicators').first().json.retail_value_previous }}; direction: {{ $('Merge Indicators').first().json.retail_direction }}.\"}]}], \"generationConfig\": {\"responseMimeType\": \"application/json\", \"temperature\": 0.2}}",
        "options": {}
      },
      "name": "Gemini Batch Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
