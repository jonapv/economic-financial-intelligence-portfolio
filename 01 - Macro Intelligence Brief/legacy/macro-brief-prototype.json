    {
      "parameters": {
        "jsCode": "// ---- Política (ajusta aquí) -------------------------------------------\nconst LIMITS = {\n  perEmailMs: 24 * 60 * 60 * 1000,            // 1 brief por email cada 24 h\n  perIp:  { max: 3,  windowMs: 60 * 60 * 1000 },       // 3 peticiones por IP y hora\n  global: { max: 20, windowMs: 24 * 60 * 60 * 1000 },  // 20 peticiones al día en total\n};\n// -----------------------------------------------------------------------\n\nconst now = Date.now();\nconst req = $input.first().json;\nconst body = req.body || {};\nconst headers = req.headers || {};\n\nconst email = String(body.email || '').trim().toLowerCase();\nconst ip = headers['cf-connecting-ip']\n  || String(headers['x-forwarded-for'] || '').split(',')[0].trim()\n  || headers['x-real-ip']\n  || 'unknown';\n\n// Estado persistente entre ejecuciones (solo en ejecuciones de producción)\nconst store = $getWorkflowStaticData('global');\nstore.rl = store.rl || { emails: {}, ips: {}, global: [] };\nconst rl = store.rl;\n\n// Purga de entradas caducadas\nfor (const [k, t] of Object.entries(rl.emails)) if (now - t >= LIMITS.perEmailMs) delete rl.emails[k];\nfor (const [k, arr] of Object.entries(rl.ips)) {\n  rl.ips[k] = arr.filter(t => now - t < LIMITS.perIp.windowMs);\n  if (!rl.ips[k].length) delete rl.ips[k];\n}\nrl.global = rl.global.filter(t => now - t < LIMITS.global.windowMs);\n\nconst secsUntil = (t, windowMs) => Math.max(1, Math.ceil((windowMs - (now - t)) / 1000));\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email);\n\nlet reason = null, retryAfter = 0;\nif (body.company) {                                   // honeypot rellenado -> bot\n  reason = 'bot';\n} else if (!emailOk) {\n  reason = 'invalid_email';\n} else if (rl.emails[email]) {\n  reason = 'email_cooldown'; retryAfter = secsUntil(rl.emails[email], LIMITS.perEmailMs);\n} else if ((rl.ips[ip] || []).length >= LIMITS.perIp.max) {\n  reason = 'ip_limit';       retryAfter = secsUntil(rl.ips[ip][0], LIMITS.perIp.windowMs);\n} else if (rl.global.length >= LIMITS.global.max) {\n  reason = 'global_limit';   retryAfter = secsUntil(rl.global[0], LIMITS.global.windowMs);\n}\n\nconst allowed = reason === null;\nif (allowed) {\n  rl.emails[email] = now;\n  (rl.ips[ip] = rl.ips[ip] || []).push(now);\n  rl.global.push(now);\n}\n\nreturn [{ json: { allowed, reason, retry_after: retryAfter, email, ip } }];"
      },
      "name": "Rate Limit Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
