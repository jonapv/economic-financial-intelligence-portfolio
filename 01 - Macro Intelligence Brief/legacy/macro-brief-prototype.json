    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "name": "Wait 30s (Retry)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        960,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates?.[0]?.content?.parts?.[0]?.text ?? '';\n// Quita posibles vallas ```json ... ``` y recorta al primer/último corchete\nlet text = raw.replace(/```json|```/gi, '').trim();\nconst start = text.indexOf('{'), end = text.lastIndexOf('}');\nif (start === -1 || end === -1) throw new Error('Gemini did not return a JSON object: ' + raw.slice(0, 200));\nconst parsed = JSON.parse(text.slice(start, end + 1));\n\nconst keys = [\"cpi_analysis\", \"unemployment_analysis\", \"fedfunds_analysis\", \"gdp_analysis\", \"retail_analysis\"];\nconst out = {};\nfor (const k of keys) {\n  if (typeof parsed[k] !== 'string' || !parsed[k].trim()) throw new Error('Missing or empty key in Gemini response: ' + k);\n  out[k] = parsed[k].trim();\n}\nreturn [{ json: out }];"
      },
      "name": "Parse Gemini JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst esc = (s) => String(s ?? '').trim()\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst today = new Date().toLocaleDateString('en-GB', {\n  day: 'numeric', month: 'long', year: 'numeric'\n});\n\nconst sections = [\n  { title: 'Inflation',       paras: [d.cpi_analysis] },\n  { title: 'Monetary Policy', paras: [d.fedfunds_analysis] },\n  { title: 'Growth',          paras: [d.gdp_analysis, d.retail_analysis] },\n  { title: 'Labour Market',   paras: [d.unemployment_analysis] },\n];\n\nconst para = (t) => `<p style=\"margin:0 0 12px 0;font-size:15px;line-height:1.65;color:#2f3b4d;\">${esc(t)}</p>`;\n\nconst sectionHtml = sections.map((s, i) => `\n  <tr>\n    <td style=\"padding:${i === 0 ? '8px' : '20px'} 36px 8px 36px;\">\n      <h2 style=\"margin:0 0 10px 0;padding-bottom:6px;font-size:17px;font-weight:700;color:#0f1c2e;border-bottom:2px solid #0f1c2e;display:inline-block;\">${esc(s.title)}</h2>\n      ${s.paras.map(para).join('')}\n    </td>\n  </tr>`).join('');\n\nconst email_html = `<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head>\n<body style=\"margin:0;padding:0;background:#f2f4f7;font-family:Helvetica,Arial,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f2f4f7;padding:32px 12px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(15,28,46,0.08);\">\n        <tr>\n          <td style=\"background:#0f1c2e;padding:30px 36px;\">\n            <h1 style=\"margin:0;font-size:24px;font-weight:700;color:#ffffff;line-height:1.25;\">Weekly Macro Intelligence Brief</h1>\n            <p style=\"margin:10px 0 0 0;font-size:13px;color:#c7d2e3;\"><strong style=\"color:#ffffff;\">Period:</strong> ${esc(today)}</p>\n          </td>\n        </tr>\n        <tr><td style=\"height:16px;\"></td></tr>\n        ${sectionHtml}\n        <tr><td style=\"height:12px;\"></td></tr>\n        <tr>\n          <td style=\"background:#f7f9fb;border-top:1px solid #e6e9ef;padding:18px 36px 22px 36px;\">\n            <h3 style=\"margin:0 0 6px 0;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#0f1c2e;\">Source Transparency</h3>\n            <p style=\"margin:0;font-size:12px;line-height:1.55;color:#6b7686;\">Original data sourced directly from the Federal Reserve Economic Data (FRED) API. Analysis generated via Google Gemini Flash.</p>\n          </td>\n        </tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>`;\n\nreturn [{ json: { ...d, email_html } }];"
      },
      "name": "Format Weekly Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
